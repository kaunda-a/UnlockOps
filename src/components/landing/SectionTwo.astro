<section>
  <div class="px-8 py-24 mx-auto md:px-12 lg:px-24 max-w-7xl relative">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-center">
      <div class="lg:col-span-3">
        <p class="text-sm leading-normal font-bold uppercase text-accent-600">
          Tagline
        </p>
        <h2
          class="text-xl leading-tight tracking-tight sm:text-2xl md:text-3xl capitalize lg:text-4xl mt-4 font-medium text-base-900 dark:text-base-100">
          Add monetization to any app in minutes
        </h2>
        <p class="text-base leading-normal mt-4 text-base-500 dark:text-base-400 font-medium">
          Integrate content gating, lead capture, and analytics with simple API calls. 
          No credit card required to start.
        </p>
        <div class="flex flex-wrap items-center gap-2 mx-auto mt-12">
          <a
            href="/signup"
            class="flex items-center justify-center transition-all duration-200 focus:ring-2 focus:outline-none text-white bg-accent-600 hover:bg-accent-700 focus:ring-accent-500/50 h-9 px-4 py-2 text-sm font-medium rounded-md">
            Get API keys — free
