---
---

<header
  class="border-b border-base-200/50 dark:border-base-800 sticky top-0 z-50 bg-base-50/80 dark:bg-base-950/80 backdrop-blur-2xl">
  <div class="w-full mx-auto px-6 max-w-7xl lg:px-12">
    <div
      x-data="{ open: false }"
      class="flex items-center justify-between w-full py-4">
      
      <!-- Logo - Left corner -->
      <a href="/" class="text-base-900 dark:text-base-100 inline-flex items-center gap-3 shrink-0">
        <img src="/logo.svg" alt="UnlockOps" class="w-9 h-9" />
        <span class="font-bold text-base">UnlockOps</span>
      </a>

      <!-- Desktop Nav - Center -->
      <nav
        :class="{'flex': open, 'hidden': !open}"
        id="main-navigation"
        class="hidden lg:flex absolute lg:relative top-full left-0 w-full lg:w-auto bg-base-50 dark:bg-base-950 lg:bg-transparent lg:dark:bg-transparent border-b lg:border-none border-base-200 dark:border-base-800 px-6 lg:px-0 pb-4 lg:pb-0 flex-col lg:flex-row lg:items-center lg:gap-8 -translate-x-1/2 left-1/2 lg:translate-x-0 lg:left-auto">
        <a
          href="/#features"
          class="text-sm text-base-600 dark:text-base-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors px-3 py-2 rounded-lg">
          Features
        </a>
        <a
          href="/#pricing"
          class="text-sm text-base-600 dark:text-base-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors px-3 py-2 rounded-lg">
          Pricing
        </a>
        <a
          href="/blog"
          class="text-sm text-base-600 dark:text-base-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors px-3 py-2 rounded-lg">
          Blog
        </a>
        <a
          href="/faq"
          class="text-sm text-base-600 dark:text-base-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors px-3 py-2 rounded-lg">
          FAQ
        </a>
      </nav>

      <!-- Right side - Theme + Buttons -->
      <div class="flex items-center gap-3">
        <button id="theme-toggle-desktop" aria-label="Toggle dark mode" class="hidden lg:inline-flex p-2 text-base-500 dark:text-base-400 hover:text-accent-600 dark:hover:text-accent-400 focus:outline-none rounded-lg">
          <svg class="size-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          <svg class="size-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </button>
        <a
          href="/signup"
          class="flex items-center justify-center transition-all duration-200 focus:ring-2 focus:outline-none text-base-600 dark:text-base-400 bg-base-50 dark:bg-base-900 hover:text-accent-600 dark:hover:text-accent-400 ring-1 ring-base-300 dark:ring-base-600 focus:ring-accent-500 h-8 px-4 py-2 text-xs font-medium rounded-lg hover:ring-accent-500">
          Sign up
        </a>
        <a
          href="/login"
          class="flex items-center justify-center transition-all duration-200 focus:ring-2 focus:outline-none text-white bg-accent-600 hover:bg-accent-700 focus:ring-accent-500/50 h-8 px-4 py-2 text-xs font-medium rounded-lg">
          Log in
        </a>

        <!-- Mobile menu button -->
        <div class="flex items-center gap-1 lg:hidden">
          <button id="theme-toggle-mobile" aria-label="Toggle dark mode" class="p-2 text-base-500 dark:text-base-400 hover:text-accent-600 dark:hover:text-accent-400 focus:outline-none rounded-lg">
            <svg class="size-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
            <svg class="size-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </button>
          <button
            @click="open = !open"
            :aria-expanded="open.toString()"
            aria-controls="main-navigation"
            aria-label="Toggle navigation menu"
            class="p-2 text-base-400 hover:text-base-900 dark:hover:text-base-100 focus:outline-none rounded-lg">
            <svg
              :class="{'rotate-90': open}"
              class="w-6 h-6 transition-transform duration-300 ease-in-out"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                x-show="!open"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16">
              </path>
              <path
                x-show="open"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12">
              </path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  function toggleTheme() {
    const html = document.documentElement;
    const isDark = html.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  }
  document.addEventListener("click", function(e) {
    if (e.target.closest("#theme-toggle-desktop") || e.target.closest("#theme-toggle-mobile")) {
      toggleTheme();
    }
  });
</script>