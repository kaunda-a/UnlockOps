---
const sections = [
  {
    title: "Product",
    links: [
      { name: "Features", href: "/#features" },
      { name: "Pricing", href: "/#pricing" },
      { name: "Documentation", href: "/docs" },
      { name: "API Reference", href: "/api" },
    ],
  },
  {
    title: "Company",
    links: [
      { name: "About", href: "/about" },
      { name: "Blog", href: "/blog" },
      { name: "Terms", href: "/terms" },
      { name: "Privacy", href: "/privacy" },
    ],
  },
  {
    title: "Resources",
    links: [
      { name: "Getting Started", href: "/docs" },
      { name: "Code Examples", href: "/examples" },
      { name: "Community", href: "/community" },
      { name: "FAQ", href: "/faq" },
    ],
  },
  {
    title: "Support",
    links: [
      { name: "Help Center", href: "/help" },
      { name: "Contact", href: "mailto:support@unlockops.com" },
      { name: "Status", href: "/status" },
    ],
  },
];
---

<footer
  class="bg-gradient-to-br from-accent-100 via-accent-50 to-base-50 dark:from-accent-950 dark:via-base-950 dark:to-base-950 border-base-200 dark:border-accent-900 mt-20">
  <div class="px-6 md:px-12 lg:px-24 py-20 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16">
      <div class="md:col-span-1">
        <a href="/" class="inline-flex items-center gap-3">
          <img src="/logo.svg" alt="UnlockOps" class="w-10 h-10" />
          <span class="text-lg font-semibold text-base-900 dark:text-base-100">UnlockOps</span>
        </a>
        <p class="mt-4 text-sm text-base-500 dark:text-base-400">
          Monetization infrastructure for developers. Add content gating, 
          lead capture, and analytics to any app — for free.
        </p>
      </div>

      <div class="md:col-span-2">
        <h3 class="text-lg font-semibold text-base-900 dark:text-base-100 mb-2">
          Join 10,000+ developers
        </h3>
        <p class="text-sm text-base-500 dark:text-base-400 mb-4">
          Get API updates, code examples, and integration tips — weekly.
        </p>
        <form class="flex flex-col sm:flex-row items-center gap-3 w-full">
          <input
            type="email"
            placeholder="Your email address"
            class="w-full px-4 py-2 border border-base-300 dark:border-base-600 rounded-md shadow-sm focus:ring-2 focus:ring-accent-500 focus:outline-none bg-base-50 dark:bg-base-900 text-base-900 dark:text-base-100"
          />
          <button
            type="submit"
            class="px-6 py-2 w-full md:w-auto rounded-md bg-accent-600 text-white hover:bg-accent-700 transition">
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-sm text-base-500 dark:text-base-400">
      {
        sections.map(({ title, links }) => (
          <div>
            <h4 class="text-base font-semibold text-base-900 dark:text-base-100 mb-5">{title}</h4>
            <ul>
              {links.map(({ name, href }) => (
                <li class="first:prose-a:pt-0 last:prose-a:pb-0">
                  <a
                    href={href}
                    class="hover:text-accent-600 dark:hover:text-accent-400 py-2 inline-block transition">
                    {name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="pt-12 mt-12 border-t border-base-200 dark:border-base-700 flex flex-col md:flex-row justify-between items-center text-xs text-base-500 dark:text-base-400">
      <p>
        &copy; {new Date().getFullYear()} UnlockOps. All rights reserved.
    </div>
  </div>
</footer>
