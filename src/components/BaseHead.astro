---
import "../styles/global.css";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Basic Meta Tags -->
<title>UnlockOps — Monetization Infrastructure for Developers</title>
<meta
  name="description"
  content="Add content gating, lead capture, and monetization to any app with AI-generated code. Free SDKs, no credit card required."
/>
<meta name="keywords" content="monetization API, content gating, lead capture, developer tools, SDK, API, code generator" />
<meta name="author" content="UnlockOps" />

<!-- Favicons -->
<link rel="icon" href="/favicon.ico" sizes="any" />

<!-- Favicon for IE -->
<link rel="shortcut icon" href="/logo.svg" type="image/x-icon" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://unlockops.com" />
<meta property="og:title" content="UnlockOps — Monetization Infrastructure for Developers" />
<meta
  property="og:description"
  content="Add content gating, lead capture, and monetization to any app. Free API keys, no credit card."
/>

<!-- Twitter -->
<meta property="twitter:card" content="summary" />
<meta property="twitter:url" content="https://unlockops.com" />
<meta property="twitter:title" content="UnlockOps — Monetization Infrastructure for Developers" />
<meta
  property="twitter:description"
  content="Add content gating, lead capture, and monetization to any app. Free API keys, no credit card."
/>

<!-- Canonical URL -->
<link rel="canonical" href="https://unlockops.com" />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<!-- Theme Color for Mobile Browsers -->
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

<!---- Alpine  -->
<script is:inline defer src="https://unpkg.com/alpinejs@3.10.5/dist/cdn.min.js">
</script>
