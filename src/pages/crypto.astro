---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Crypto Prices - Live Bitcoin & Cryptocurrency Prices">
  <div class="min-h-screen bg-base-50 dark:bg-base-950">
    <div class="max-w-6xl mx-auto px-8 py-16">
      <h1 class="text-4xl font-bold text-base-900 dark:text-base-100 mb-2">Cryptocurrency Prices</h1>
      <p class="text-base-500 dark:text-base-400 mb-8">Live prices for top cryptocurrencies</p>

      <div id="loading" class="text-center py-12 text-base-500">
        Loading prices...
      </div>

      <div id="prices" class="hidden">
        <div class="grid gap-4" id="cryptoList">
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const coins = [
    { id: 'bitcoin', symbol: 'BTC', name: 'Bitcoin' },
    { id: 'ethereum', symbol: 'ETH', name: 'Ethereum' },
    { id: 'tether', symbol: 'USDT', name: 'Tether' },
    { id: 'binancecoin', symbol: 'BNB', name: 'BNB' },
    { id: 'solana', symbol: 'SOL', name: 'Solana' },
    { id: 'ripple', symbol: 'XRP', name: 'XRP' },
    { id: 'dogecoin', symbol: 'DOGE', name: 'Dogecoin' },
    { id: 'cardano', symbol: 'ADA', name: 'Cardano' },
    { id: 'litecoin', symbol: 'LTC', name: 'Litecoin' },
    { id: 'polkadot', symbol: 'DOT', name: 'Polkadot' }
  ];

  async function loadPrices() {
    try {
      const res = await fetch(
        'https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=10&page=1&sparkline=false'
      );
      const data = await res.json();

      const list = document.getElementById('cryptoList')!;
      list.innerHTML = data.map((coin: any) => {
        const change = coin.price_change_percentage_24h;
        const isUp = change >= 0;
        return `
          <div class="bg-white dark:bg-base-900 rounded-xl p-6 border border-base-200 dark:border-base-800 flex items-center justify-between">
            <div class="flex items-center gap-4">
              <img src="${coin.image}" alt="${coin.name}" class="w-12 h-12 rounded-full" />
              <div>
                <h3 class="text-lg font-bold text-base-900 dark:text-base-100">${coin.name}</h3>
                <p class="text-base-500 dark:text-base-400">${coin.symbol.toUpperCase()}</p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-xl font-bold text-base-900 dark:text-base-100">$${coin.current_price.toLocaleString()}</p>
              <p class="${isUp ? 'text-green-500' : 'text-red-500'}">${isUp ? '↑' : '↓'} ${Math.abs(change).toFixed(2)}%</p>
            </div>
          </div>
        `;
      }).join('');

      document.getElementById('loading')?.classList.add('hidden');
      document.getElementById('prices')?.classList.remove('hidden');
    } catch (e) {
      document.getElementById('loading')!.textContent = 'Failed to load prices. Please refresh.';
    }
  }

  loadPrices();
  setInterval(loadPrices, 60000);
</script>