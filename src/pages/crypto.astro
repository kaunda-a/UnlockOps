---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Crypto Prices - Live Bitcoin & Cryptocurrency Prices">
  <div class="min-h-screen bg-base-50 dark:bg-base-950">
    <div class="max-w-4xl mx-auto px-8 py-16">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-base-900 dark:text-base-100 mb-2">Cryptocurrency Prices</h1>
        <p class="text-base-500 dark:text-base-400">Live crypto prices updated every minute</p>
      </div>

      <div id="loading" class="text-center py-20">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-accent-500"></div>
        <p class="mt-4 text-base-500 dark:text-base-400">Loading prices...</p>
      </div>

      <div id="prices" class="hidden">
        <div class="grid gap-3" id="cryptoList"></div>
        <p class="text-center text-base-500 dark:text-base-400 text-sm mt-6">
          Prices auto-refresh every 60 seconds
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  async function loadPrices() {
    try {
      const res = await fetch(
        'https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=10&page=1&sparkline=false'
      );
      const data = await res.json();

      const list = document.getElementById('cryptoList')!;
      list.innerHTML = data.map((coin: any) => {
        const change = coin.price_change_percentage_24h;
        const isUp = change >= 0;
        return `
          <div class="bg-white dark:bg-base-900 rounded-xl p-4 border border-base-200 dark:border-base-800 flex items-center justify-between hover:border-accent-500 dark:hover:border-accent-500 transition-colors">
            <div class="flex items-center gap-4">
              <img src="${coin.image}" alt="${coin.symbol}" class="w-10 h-10 rounded-full" />
              <div>
                <h3 class="text-lg font-semibold text-base-900 dark:text-base-100">${coin.name}</h3>
                <p class="text-base-500 dark:text-base-400 text-sm">${coin.symbol.toUpperCase()}</p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-lg font-bold text-base-900 dark:text-base-100">$${coin.current_price.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</p>
              <p class="${isUp ? 'text-green-500' : 'text-red-500'} text-sm font-medium">${isUp ? '▲' : '▼'} ${Math.abs(change).toFixed(2)}%</p>
            </div>
          </div>
        `;
      }).join('');

      document.getElementById('loading')?.classList.add('hidden');
      document.getElementById('prices')?.classList.remove('hidden');
    } catch (e) {
      document.getElementById('loading')!.innerHTML = '<p class="text-red-500">Failed to load prices. <button onclick="location.reload()" class="underline">Refresh</button></p>';
    }
  }

  loadPrices();
  setInterval(loadPrices, 60000);
</script>