  <script>
    // Table of Contents smooth scrolling
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });

    // Reading progress indicator
    const createProgressBar = () => {
      const progressBar = document.createElement('div');
      progressBar.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: linear-gradient(to right, #667eea, #764ba2);
        width: 0%;
        z-index: 1000;
        transition: width 0.1s ease-out;
      `;
      document.body.appendChild(progressBar);

      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = (scrollTop / docHeight) * 100;
        progressBar.style.width = scrollPercent + '%';
      });
    };

    createProgressBar();

    // Social sharing functionality
    const shareButtons = document.querySelectorAll('button');
    shareButtons.forEach(button => {
      const svg = button.querySelector('svg');
      if (svg) {
        button.addEventListener('click', () => {
          const url = encodeURIComponent(window.location.href);
          const title = encodeURIComponent(document.querySelector('h1')?.textContent || '');
          
          let shareUrl = '';
          
          // Check which social media platform based on SVG path
          const pathData = svg.querySelector('path')?.getAttribute('d') || '';
          
          if (pathData.includes('24 4.557')) {
            // Twitter/X
            shareUrl = `https://twitter.com/intent/tweet?url=${url}&text=${title}`;
          } else if (pathData.includes('20.447 20.452')) {
            // LinkedIn
            shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;
          } else if (pathData.includes('12 0c-6.626')) {
            // GitHub
            shareUrl = `https://github.com/sharer/sharer.php?u=${url}`;
          }
          
          if (shareUrl) {
            window.open(shareUrl, '_blank', 'width=600,height=400');
          }
        });
      }
    });

    // CPA Locker trigger functions
    function triggerContentLocker() {
      // Load CPA Grip content locker
      var script = document.createElement('script');
      script.type = 'text/javascript';
      script.text = 'var lck = false;';
      document.body.appendChild(script);

      var lockerScript = document.createElement('script');
      lockerScript.type = 'text/javascript';
      lockerScript.src = 'https://quartzfiles.com/script_include.php?id=1894762&tracking_id=';
      document.body.appendChild(lockerScript);

      var checkScript = document.createElement('script');
      checkScript.type = 'text/javascript';
      checkScript.text = "if(!lck){top.location = 'https://quartzfiles.com/help/ablk.php?lkt=1'; }";
      document.body.appendChild(checkScript);
    }

    function triggerVideoLocker() {
