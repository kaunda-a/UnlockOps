  <script>
    // Table of Contents smooth scrolling
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });

    // Reading progress indicator
    const createProgressBar = () => {
      const progressBar = document.createElement('div');
      progressBar.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: linear-gradient(to right, #667eea, #764ba2);
        width: 0%;
        z-index: 1000;
        transition: width 0.1s ease-out;
      `;
      document.body.appendChild(progressBar);

      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = (scrollTop / docHeight) * 100;
        progressBar.style.width = scrollPercent + '%';
      });
    };

    createProgressBar();

    // Social sharing functionality
    const shareButtons = document.querySelectorAll('button');
    shareButtons.forEach(button => {
      const svg = button.querySelector('svg');
      if (svg) {
        button.addEventListener('click', () => {
          const url = encodeURIComponent(window.location.href);
          const title = encodeURIComponent(document.querySelector('h1')?.textContent || '');
          
          let shareUrl = '';
          
          // Check which social media platform based on SVG path
          const pathData = svg.querySelector('path')?.getAttribute('d') || '';
          
          if (pathData.includes('24 4.557')) {
            // Twitter/X
            shareUrl = `https://twitter.com/intent/tweet?url=${url}&text=${title}`;
          } else if (pathData.includes('20.447 20.452')) {
            // LinkedIn
            shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;
          } else if (pathData.includes('12 0c-6.626')) {
            // GitHub
            shareUrl = `https://github.com/sharer/sharer.php?u=${url}`;
          }
          
          if (shareUrl) {
            window.open(shareUrl, '_blank', 'width=600,height=400');
          }
        });
      }
    });

    // CPA Locker trigger functions - make them globally accessible
    window.triggerContentLocker = function() {
      // Set lck in global scope
      window.lck = false;

      // Create and load the locker script
      var lockerScript = document.createElement('script');
      lockerScript.type = 'text/javascript';
      lockerScript.src = 'https://quartzfiles.com/script_include.php?id=1894762';
      document.head.appendChild(lockerScript);

      // Start polling for locker completion
      window.checkContentLockerCompletion();
    };

    window.triggerVideoLocker = function() {
      // Set lck in global scope
      window.lck = false;

      // Create and load the locker script
      var lockerScript = document.createElement('script');
      lockerScript.type = 'text/javascript';
      lockerScript.src = 'https://quartzfiles.com/script_include.php?id=1894955';
      document.head.appendChild(lockerScript);

      // Start polling for locker completion
      window.checkVideoLockerCompletion();
    };

    // Check for content locker completion
    window.checkContentLockerCompletion = function() {
      var checkInterval = setInterval(function() {
        if (typeof window.lck !== 'undefined' && window.lck === true) {
          clearInterval(checkInterval);
          var downloadLinks = document.getElementById('download-links');
          if (downloadLinks) {
            downloadLinks.classList.remove('hidden');
          }
        }
      }, 1000);

      // Stop checking after 5 minutes
      setTimeout(function() {
        clearInterval(checkInterval);
      }, 300000);
    };

    // Check for video locker completion
    window.checkVideoLockerCompletion = function() {
      var checkInterval = setInterval(function() {
        if (typeof window.lck !== 'undefined' && window.lck === true) {
          clearInterval(checkInterval);
          var videoCourse = document.getElementById('video-course');
          if (videoCourse) {
            videoCourse.classList.remove('hidden');
          }
          var videoAccess = document.getElementById('video-access');
          if (videoAccess) {
            videoAccess.classList.remove('hidden');
          }
        }
      }, 1000);

      // Stop checking after 5 minutes
      setTimeout(function() {
        clearInterval(checkInterval);
      }, 300000);
    };

    // Ebook Content Locker trigger function
    window.triggerEbookLocker = function() {
      // Set lck in global scope
      window.lck = false;

      // Create and load the locker script
      var lockerScript = document.createElement('script');
      lockerScript.type = 'text/javascript';
      lockerScript.src = 'https://quartzfiles.com/script_include.php?id=1894762';
      document.head.appendChild(lockerScript);

      // Start polling for locker completion
      window.checkEbookLockerCompletion();
    };

    // Check for ebook locker completion
    window.checkEbookLockerCompletion = function() {
      var checkInterval = setInterval(function() {
        if (typeof window.lck !== 'undefined' && window.lck === true) {
          clearInterval(checkInterval);
          var ebookDownload = document.getElementById('ebook-download');
          if (ebookDownload) {
            ebookDownload.classList.remove('hidden');
          }
        }
      }, 1000);

      // Stop checking after 5 minutes
      setTimeout(function() {
        clearInterval(checkInterval);
      }, 300000);
    };
  </script>
