<BaseLayout>
  <article class="py-20">
    <div class="px-8 mx-auto md:px-12 lg:px-24 max-w-4xl">
      <nav class="flex items-center gap-2 text-sm text-base-500 dark:text-base-400 mb-8">
        <a href="/blog" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
          Blog
        </a>
        <span>/</span>
        <span class="text-base-900 dark:text-base-100">{post.title}</span>
      </nav>

      <header class="mb-12">
        <div class="flex items-center gap-2 mb-4">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-accent-600 text-white">
            {post.category}
          </span>
          <span class="text-sm text-base-500 dark:text-base-400">{post.readTime}</span>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-base-900 dark:text-base-100 mb-6">
          {post.title}
        </h1>
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2">
            <div class="w-10 h-10 rounded-full bg-accent-100 dark:bg-accent-900 flex items-center justify-center">
              <span class="text-sm font-medium text-accent-700 dark:text-accent-300">
                {post.author.split(' ').map(n => n[0]).join('')}
              </span>
            </div>
            <div>
              <p class="text-sm font-medium text-base-900 dark:text-base-100">{post.author}</p>
              <p class="text-xs text-base-500 dark:text-base-400">{post.date}</p>
            </div>
          </div>
        </div>
      </header>

      <div class="aspect-video bg-gradient-to-br from-accent-100 to-accent-200 dark:from-accent-900 dark:to-accent-800 rounded-2xl mb-12 overflow-hidden">
        <img src={post.image} alt={post.title} class="w-full h-full object-cover" />
      </div>

      <!-- Table of Contents -->
      <div class="mb-8 p-6 bg-base-50 dark:bg-base-800 rounded-xl border border-base-200 dark:border-base-700">
        <h3 class="text-lg font-semibold text-base-900 dark:text-base-100 mb-4">
          Table of Contents
        </h3>
        <nav class="space-y-2">
          <a href="#understanding-content-lockers" class="block text-base text-base-600 dark:text-base-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
            Understanding Content Lockers
          </a>
          <a href="#best-practices" class="block text-base text-base-600 dark:text-base-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
            Best Practices
          </a>
          <a href="#getting-started" class="block text-base text-base-600 dark:text-base-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
            Getting Started
          </a>
          <a href="#advanced-strategies" class="block text-base text-base-600 dark:text-base-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
            Advanced Strategies
          </a>
        </nav>
      </div>

      <div class="prose prose-lg max-w-none dark:prose-invert">
        <p class="text-xl text-base-600 dark:text-base-400 mb-8">
          {post.excerpt}
        </p>
        <div class="text-base-700 dark:text-base-300 whitespace-pre-line">
          {post.content}
        </div>
      </div>

      <!-- Downloadable Content Section with Locker -->
