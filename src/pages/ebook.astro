---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="py-20">
    <div class="px-8 mx-auto md:px-12 lg:px-24 max-w-4xl">
      <nav class="flex items-center gap-2 text-sm text-base-500 dark:text-base-400 mb-8">
        <a href="/" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
          Home
        </a>
        <span>/</span>
        <span class="text-base-900 dark:text-base-100">Free Ebook</span>
      </nav>

      <header class="mb-12">
        <div class="flex items-center gap-2 mb-4">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300">
            Free Download
          </span>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-base-900 dark:text-base-100 mb-6">
          Artificial Intelligence in Digital Marketing
        </h1>
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2">
            <div class="w-10 h-10 rounded-full bg-purple-100 dark:bg-purple-900 flex items-center justify-center">
              <span class="text-sm font-medium text-purple-700 dark:text-purple-300">
                AI
              </span>
            </div>
            <div>
              <p class="text-sm font-medium text-base-900 dark:text-base-100">UnlockOps Team</p>
              <p class="text-xs text-base-500 dark:text-base-400">May 2024</p>
            </div>
          </div>
        </div>
      </header>

      <div class="aspect-video bg-gradient-to-br from-purple-100 to-purple-200 dark:from-purple-900 dark:to-purple-800 rounded-2xl mb-12 overflow-hidden">
        <img src="/blog/ai-code-gen.svg" alt="AI in Digital Marketing Ebook" class="w-full h-full object-cover" />
      </div>

      <div class="prose prose-lg max-w-none dark:prose-invert mb-12">
        <p class="text-xl text-base-600 dark:text-base-400 mb-8">
          Discover how AI is revolutionizing digital marketing and learn how to leverage these powerful tools to grow your business. This comprehensive guide covers everything from AI-powered content creation to automated customer engagement.
        </p>
        
        <h2 class="text-2xl font-bold text-base-900 dark:text-base-100 mb-4">What You'll Learn:</h2>
        <ul class="list-disc pl-6 space-y-2 text-base-700 dark:text-base-300 mb-8">
          <li>AI-powered content creation strategies</li>
          <li>Automated email marketing optimization</li>
          <li>Chatbot implementation best practices</li>
          <li>Predictive analytics for better targeting</li>
          <li>AI tools for social media management</li>
          <li>Machine learning for conversion optimization</li>
        </ul>

        <h2 class="text-2xl font-bold text-base-900 dark:text-base-100 mb-4">Bonus:</h2>
        <p class="text-base-700 dark:text-base-300">
          This ebook comes with <strong>Master Resell Rights</strong> - you can resell it and keep 100% of the profits!
        </p>
      </div>

      <!-- Ebook Download Section with CPA Content Locker -->
      <div class="mt-12 pt-8 border-t border-base-200 dark:border-base-700">
        <div class="bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-900/30 dark:to-purple-800/30 rounded-2xl p-8 border border-purple-200 dark:border-purple-700">
          <div class="flex items-start gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-purple-600 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-base-900 dark:text-base-100 mb-2">
                Download Your Free Ebook
              </h3>
              <p class="text-base text-base-600 dark:text-base-400">
                Get instant access to this comprehensive guide on AI in Digital Marketing with Master Resell Rights.
              </p>
            </div>
          </div>

          <!-- Content Locker Section -->
          <div class="bg-white dark:bg-base-800 rounded-xl p-6 border border-base-200 dark:border-base-700">
            <div class="text-center mb-4">
              <p class="text-sm text-base-500 dark:text-base-400 mb-2">
                🎁 Your free ebook is ready! Click below to download:
              </p>
              <div class="flex flex-wrap justify-center gap-2 mb-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300">
                  ✓ PDF Guide
                </span>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300">
                  ✓ Master Resell Rights
                </span>
              </div>
              <p class="text-xs text-base-400 dark:text-base-500">
                Complete a quick offer to unlock your download
              </p>
            </div>

            <!-- Download Button (Triggers content locker on click) -->
            <div class="space-y-3">
              <button onclick="window.triggerEbookLocker()" class="w-full flex items-center justify-between p-4 bg-purple-50 dark:bg-purple-900/30 rounded-lg hover:bg-purple-100 dark:hover:bg-purple-900/50 transition-colors border border-purple-200 dark:border-purple-700 text-left">
                <div class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  <span class="text-sm font-medium text-base-900 dark:text-base-100">Download AI in Digital Marketing Ebook</span>
                </div>
                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
              </button>
            </div>

            <!-- Actual Download Link (Hidden until offer completed) -->
            <div id="ebook-download" class="hidden mt-6 pt-6 border-t border-base-200 dark:border-base-700">
              <p class="text-sm font-medium text-base-900 dark:text-base-100 mb-4">
                🎉 Your ebook is ready! Download below:
              </p>
              <div class="space-y-3">
                <a href="/ebooks/artificial-intelligence-in-digital-marketing.zip" download class="flex items-center justify-between p-4 bg-purple-50 dark:bg-purple-900/30 rounded-lg hover:bg-purple-100 dark:hover:bg-purple-900/50 transition-colors border border-purple-200 dark:border-purple-700">
                  <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <span class="text-sm font-medium text-base-900 dark:text-base-100">AI in Digital Marketing (ZIP)</span>
                  </div>
                  <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 pt-8 border-t border-base-200 dark:border-base-700">
        <div class="bg-base-50 dark:bg-base-800 rounded-2xl p-8 border border-base-200 dark:border-base-700">
          <h3 class="text-lg font-semibold text-base-900 dark:text-base-100 mb-4">
            Want to learn more about AI in marketing?
          </h3>
          <p class="text-base text-base-600 dark:text-base-400 mb-6">
            Check out our comprehensive guide on AI-powered code generation for custom lockers.
          </p>
          <a href="/blog/4" class="inline-flex items-center justify-center transition-all duration-200 focus:ring-2 focus:outline-none text-white bg-accent-600 hover:bg-accent-700 focus:ring-accent-500/50 h-10 px-6 py-3 text-sm font-medium rounded-lg">
            Read More
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Ebook Content Locker trigger function
    window.triggerEbookLocker = function() {
      // Set lck in global scope
      window.lck = false;

      // Create and load the locker script
      var lockerScript = document.createElement('script');
      lockerScript.type = 'text/javascript';
      lockerScript.src = 'https://quartzfiles.com/script_include.php?id=1894762';
      document.head.appendChild(lockerScript);

      // Start polling for locker completion
      window.checkEbookLockerCompletion();
    };

    // Check for ebook locker completion
    window.checkEbookLockerCompletion = function() {
      var checkInterval = setInterval(function() {
        if (typeof window.lck !== 'undefined' && window.lck === true) {
          clearInterval(checkInterval);
          var downloadLink = document.getElementById('ebook-download');
          if (downloadLink) {
            downloadLink.classList.remove('hidden');
          }
        }
      }, 1000);

      // Stop checking after 5 minutes
      setTimeout(function() {
        clearInterval(checkInterval);
      }, 300000);
    };
  </script>
</BaseLayout>