---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Latest News - Tech & Business Headlines">
  <div class="min-h-screen bg-base-50 dark:bg-base-950">
    <div class="max-w-6xl mx-auto px-8 py-16">
      <h1 class="text-4xl font-bold text-base-900 dark:text-base-100 mb-2">Latest News</h1>
      <p class="text-base-500 dark:text-base-400 mb-8">Top tech and business headlines</p>

      <div id="loading" class="text-center py-12 text-base-500">
        Loading news...
      </div>

      <div id="news" class="hidden">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="newsList">
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  async function loadNews() {
    try {
      const res = await fetch(
        'https://dev.to/api/articles?per_page=12&top=1'
      );
      const data = await res.json();

      const list = document.getElementById('newsList')!;
      list.innerHTML = data.map((article: any) => `
        <a href="${article.url}" target="_blank" rel="noopener" class="bg-white dark:bg-base-900 rounded-xl p-6 border border-base-200 dark:border-base-800 hover:border-accent-500 dark:hover:border-accent-500 transition-colors">
          ${article.cover_image ? `<img src="${article.cover_image}" alt="" class="w-full h-40 object-cover rounded-lg mb-4" />` : ''}
          <h3 class="text-lg font-bold text-base-900 dark:text-base-100 mb-2 line-clamp-2">${article.title}</h3>
          <p class="text-base-500 dark:text-base-400 text-sm mb-4 line-clamp-2">${article.description || ''}</p>
          <div class="flex items-center justify-between text-sm text-base-500 dark:text-base-400">
            <span>${article.user?.name || 'Unknown'}</span>
            <span>${new Date(article.published_at).toLocaleDateString()}</span>
          </div>
        </a>
      `).join('');

      document.getElementById('loading')?.classList.add('hidden');
      document.getElementById('news')?.classList.remove('hidden');
    } catch (e) {
      document.getElementById('loading')!.textContent = 'Failed to load news. Please refresh.';
    }
  }

  loadNews();
</script>